// Sample transactions until Room is implemented.
private data class SampleTransaction(
    val name: String,
    val category: String,
    val date: String,
    val amount: Double,
    val icon: ImageVector
)

private val sampleTransactions = listOf(
    SampleTransaction(
        "Groceries", "Food", "Oct 24", -85.50,
        Icons.Outlined.ShoppingBasket
    ),
    SampleTransaction(
        "Coffee", "Food", "Oct 24", -6.75,
        Icons.Outlined.Coffee
    ),
    SampleTransaction(
        "Part-Time Job", "Salary", "Oct 23", 950.00,
        Icons.Outlined.Work
    ),
    SampleTransaction(
        "Transportation", "Transportation", "Oct 22", -35.00,
        Icons.Outlined.DirectionsBus
    ),
    SampleTransaction(
        "School Supplies", "School", "Oct 21", -42.25,
        Icons.Outlined.School
    )
)

private fun money(value: Double): String =
    String.format(Locale.US, "\$%,.2f", value)

// Only income and expenses can be edited.
private enum class EditableAmount(val label: String) {
    INCOME("Monthly Income"),
    EXPENSES("Monthly Expenses")
}

private data class DashboardInitialAmounts(
    val income: Double?,
    val expenses: Double?
)

@Composable
fun DashboardScreen(
    userName: String,
    userEmail: String,
    onLogout: () -> Unit,
    isDarkMode: Boolean,
    onDarkModeChange: (Boolean) -> Unit
) {
    val context = LocalContext.current

    val preferences = remember(context) {
        context.getSharedPreferences(
            "spendwise_dashboard",
            Context.MODE_PRIVATE
        )
    }

    val keyPrefix = "${userEmail.ifBlank { userName }}_"

    val userUid = FirebaseAuth.getInstance()
        .currentUser?.uid.orEmpty()

    // Determine whether the account was newly registered.
    val isNewAccount = remember(userUid) {
        userUid.isNotEmpty() &&
                preferences.getBoolean(
                    "new_user_$userUid",
                    false
                )
    }

    // Load previously saved financial information.
    val initialAmounts = remember(
        keyPrefix,
        userUid,
        isNewAccount
    ) {
        val incomeKey = "${keyPrefix}income"
        val expensesKey = "${keyPrefix}expenses"

        val hasSavedAmounts =
            preferences.contains(incomeKey) ||
                    preferences.contains(expensesKey)

        // Preserve original demo figures for existing users.
        if (!isNewAccount && !hasSavedAmounts) {
            preferences.edit()
                .putString(incomeKey, "3200.0")
                .putString(expensesKey, "750.0")
                .apply()
        }

        DashboardInitialAmounts(
            income = preferences.getString(
                incomeKey,
                null
            )?.toDoubleOrNull(),

            expenses = preferences.getString(
                expensesKey,
                null
            )?.toDoubleOrNull()
        )
    }

    var monthlyIncome by remember(keyPrefix, userUid) {
        mutableStateOf(initialAmounts.income)
    }

    var monthlyExpenses by remember(keyPrefix, userUid) {
        mutableStateOf(initialAmounts.expenses)
    }

    var balanceVisible by rememberSaveable {
        mutableStateOf(true)
    }

    var showAccountMenu by remember {
        mutableStateOf(false)
    }

    var editingAmount by remember(keyPrefix) {
        mutableStateOf<EditableAmount?>(null)
    }

    val colors = MaterialTheme.colorScheme

    val titleColor = colors.onBackground
    val mutedColor = colors.onSurfaceVariant
    val accentColor = colors.primary
    val cardColor = colors.surface
    val borderColor = colors.outline

    val balanceCardColor = colors.tertiaryContainer
    val balanceTextColor = colors.onTertiaryContainer

    // Current Balance is calculated automatically.
    // It cannot be edited independently.
    val currentBalance = monthlyIncome?.let { income ->
        monthlyExpenses?.let { expenses ->
            income - expenses
        }
    }

    // Temporary budget until the Budget screen is built.
    val monthlyBudget = 1200.0

    val remaining = monthlyExpenses?.let {
        monthlyBudget - it
    }

    val percentUsed = monthlyExpenses?.let {
        it / monthlyBudget * 100.0
    }

    val progress = (
            (monthlyExpenses ?: 0.0) / monthlyBudget
            ).toFloat().coerceIn(0f, 1f)

    val percentText = percentUsed?.let {
        String.format(Locale.US, "%.1f", it)
    } ?: "—"

    val barColor = when {
        percentUsed == null -> accentColor
        percentUsed >= 100.0 -> colors.error
        percentUsed >= 80.0 -> SpendWarning
        else -> accentColor
    }

    val statusText = when {
        remaining == null ->
            "Enter your monthly expenses to track your budget."

        remaining >= 0 ->
            "${money(remaining)} remaining"

        else ->
            "Over budget by ${money(-remaining)}"
    }

    // Time-based greeting.
    val hour = Calendar.getInstance()
        .get(Calendar.HOUR_OF_DAY)

    val greeting = when {
        hour < 12 -> "Good Morning!"
        hour < 18 -> "Good Afternoon!"
        else -> "Good Evening!"
    }

    val displayName = userName.ifBlank { userEmail }

    Column(
        modifier = Modifier
            .fillMaxSize()
            .verticalScroll(rememberScrollState())
            .padding(
                horizontal = 20.dp,
                vertical = 12.dp
            ),
        verticalArrangement = Arrangement.spacedBy(16.dp)
    ) {

        // Header and account settings.
        Row(
            verticalAlignment = Alignment.CenterVertically
        ) {
            Column(
                modifier = Modifier.weight(1f)
            ) {
                Text(
                    text = greeting,
                    style = MaterialTheme.typography.headlineMedium,
                    fontWeight = FontWeight.Bold,
                    color = titleColor
                )

                Text(
                    text = "Signed in as $displayName",
                    style = MaterialTheme.typography.bodySmall,
                    color = mutedColor
                )
            }

            Box {
                IconButton(
                    onClick = {
                        showAccountMenu = true
                    }
                ) {
                    Icon(
                        imageVector = Icons.Outlined.MoreVert,
                        contentDescription = "Account options",
                        tint = titleColor
                    )
                }

                // Light green account menu.
                DropdownMenu(
                    expanded = showAccountMenu,
                    onDismissRequest = {
                        showAccountMenu = false
                    },
                    shape = RoundedCornerShape(16.dp),
                    containerColor = colors.primaryContainer
                ) {
                    DropdownMenuItem(
                        text = {
                            Text(
                                text = if (isDarkMode) {
                                    "Light mode"
                                } else {
                                    "Dark mode"
                                },
                                color = colors.onPrimaryContainer
                            )
                        },
                        onClick = {
                            showAccountMenu = false
                            onDarkModeChange(!isDarkMode)
                        },
                        leadingIcon = {
                            Icon(
                                imageVector = if (isDarkMode) {
                                    Icons.Outlined.LightMode
                                } else {
                                    Icons.Outlined.DarkMode
                                },
                                contentDescription = null,
                                tint = colors.onPrimaryContainer
                            )
                        },
                        trailingIcon = {
                            Switch(
                                checked = isDarkMode,
                                onCheckedChange = { enabled ->
                                    showAccountMenu = false
                                    onDarkModeChange(enabled)
                                }
                            )
                        }
                    )

                    HorizontalDivider(
                        color = colors.onPrimaryContainer.copy(
                            alpha = 0.15f
                        )
                    )

                    DropdownMenuItem(
                        text = {
                            Text(
                                text = "Log out",
                                color = colors.onPrimaryContainer
                            )
                        },
                        onClick = {
                            showAccountMenu = false
                            onLogout()
                        },
                        leadingIcon = {
                            Icon(
                                imageVector =
                                    Icons.AutoMirrored.Filled.Logout,
                                contentDescription = null,
                                tint = colors.onPrimaryContainer
                            )
                        }
                    )
                }
            }
        }

        // Current Balance card.
        Card(
            modifier = Modifier.fillMaxWidth(),
            shape = RoundedCornerShape(20.dp),
            colors = CardDefaults.cardColors(
                containerColor = balanceCardColor
            )
        ) {
            Column(
                modifier = Modifier.padding(20.dp)
            ) {
                Row(
                    verticalAlignment = Alignment.CenterVertically
                ) {
                    Text(
                        text = "Current Balance",
                        style = MaterialTheme.typography.bodyMedium,
                        color = balanceTextColor.copy(
                            alpha = 0.8f
                        ),
                        modifier = Modifier.weight(1f)
                    )

                    // Eye button only.
                    // Current Balance cannot be edited.
                    IconButton(
                        onClick = {
                            balanceVisible = !balanceVisible
                        }
                    ) {
                        Icon(
                            imageVector = if (balanceVisible) {
                                Icons.Outlined.Visibility
                            } else {
                                Icons.Outlined.VisibilityOff
                            },
                            contentDescription =
                                if (balanceVisible) {
                                    "Hide balance"
                                } else {
                                    "Show balance"
                                },
                            tint = balanceTextColor
                        )
                    }
                }

                Spacer(Modifier.height(8.dp))

                Text(
                    text = if (!balanceVisible) {
                        "••••••"
                    } else {
                        currentBalance?.let(::money) ?: "—"
                    },
                    fontSize = 36.sp,
                    fontWeight = FontWeight.Bold,
                    color = balanceTextColor
                )

                Spacer(Modifier.height(8.dp))

                Text(
                    text = "Tracked by you. No bank connection.",
                    style = MaterialTheme.typography.bodySmall,
                    color = balanceTextColor.copy(
                        alpha = 0.8f
                    )
                )
            }
        }

        // Editable Monthly Income and Expenses.
        Row(
            horizontalArrangement = Arrangement.spacedBy(12.dp)
        ) {
            StatCard(
                label = "Monthly Income",
                value = monthlyIncome?.let(::money) ?: "—",
                valueColor = accentColor,
                onEdit = {
                    editingAmount = EditableAmount.INCOME
                },
                modifier = Modifier.weight(1f)
            )

            StatCard(
                label = "Monthly Expenses",
                value = monthlyExpenses?.let(::money) ?: "—",
                valueColor = titleColor,
                onEdit = {
                    editingAmount = EditableAmount.EXPENSES
                },
                modifier = Modifier.weight(1f)
            )
        }

        // Monthly Budget Overview.
        Card(
            modifier = Modifier.fillMaxWidth(),
            shape = RoundedCornerShape(16.dp),
            colors = CardDefaults.cardColors(
                containerColor = cardColor
            )
        ) {
            Column(
                modifier = Modifier.padding(16.dp)
            ) {
                Row(
                    verticalAlignment = Alignment.CenterVertically
                ) {
                    Text(
                        text = "Monthly Budget Overview",
                        style = MaterialTheme.typography.titleMedium,
                        fontWeight = FontWeight.SemiBold,
                        color = titleColor,
                        modifier = Modifier.weight(1f)
                    )

                    Text(
                        text = if (percentUsed == null) {
                            "—"
                        } else {
                            "$percentText% used"
                        },
                        style = MaterialTheme.typography.bodyMedium,
                        fontWeight = FontWeight.SemiBold,
                        color = titleColor
                    )
                }

                Spacer(Modifier.height(8.dp))

                Text(
                    text = "${monthlyExpenses?.let(::money) ?: "—"} " +
                            "spent of ${money(monthlyBudget)} (demo budget)",
                    style = MaterialTheme.typography.bodyMedium,
                    color = mutedColor
                )

                Spacer(Modifier.height(10.dp))

                LinearProgressIndicator(
                    progress = { progress },
                    color = barColor,
                    trackColor = colors.secondaryContainer,
                    modifier = Modifier
                        .fillMaxWidth()
                        .height(10.dp)
                        .clip(RoundedCornerShape(5.dp))
                )

                Spacer(Modifier.height(8.dp))

                Text(
                    text = statusText,
                    style = MaterialTheme.typography.bodyMedium,
                    fontWeight = FontWeight.SemiBold,
                    color = if (
                        remaining == null || remaining >= 0
                    ) {
                        accentColor
                    } else {
                        colors.error
                    }
                )
            }
        }

        // Five recent sample transactions.
        Card(
            modifier = Modifier.fillMaxWidth(),
            shape = RoundedCornerShape(16.dp),
            colors = CardDefaults.cardColors(
                containerColor = cardColor
            )
        ) {
            Column(
                modifier = Modifier.padding(
                    horizontal = 16.dp,
                    vertical = 12.dp
                )
            ) {
                Text(
                    text = "Recent transactions",
                    style = MaterialTheme.typography.titleMedium,
                    fontWeight = FontWeight.SemiBold,
                    color = titleColor
                )

                if (isNewAccount) {
                    Spacer(Modifier.height(12.dp))

                    Text(
                        text = "No transactions yet. Add your first " +
                                "transaction to get started.",
                        style = MaterialTheme.typography.bodySmall,
                        color = mutedColor
                    )
                } else {
                    Column(
                        modifier = Modifier
                            .fillMaxWidth()
                            .height(220.dp)
                            .verticalScroll(rememberScrollState())
                    ) {
                        sampleTransactions.take(5)
                            .forEachIndexed { index, transaction ->

                                if (index > 0) {
                                    HorizontalDivider(
                                        color = borderColor
                                    )
                                }

                                TransactionRow(transaction)
                            }
                    }

                    Spacer(Modifier.height(4.dp))

                    Text(
                        text = "Prototype sample data. Real transactions " +
                                "will come from the Room database next.",
                        style = MaterialTheme.typography.bodySmall,
                        color = mutedColor
                    )
                }
            }
        }

        Spacer(Modifier.height(8.dp))
    }

    // Only income and expense editing is supported.
    editingAmount?.let { field ->
        EditAmountDialog(
            label = field.label,

            currentValue = when (field) {
                EditableAmount.INCOME -> monthlyIncome
                EditableAmount.EXPENSES -> monthlyExpenses
            },

            onDismiss = {
                editingAmount = null
            },

            onSave = { amount ->
                when (field) {

                    EditableAmount.INCOME -> {
                        monthlyIncome = amount

                        preferences.edit()
                            .putString(
                                "${keyPrefix}income",
                                amount.toString()
                            )
                            .apply()
                    }

                    EditableAmount.EXPENSES -> {
                        monthlyExpenses = amount

                        preferences.edit()
                            .putString(
                                "${keyPrefix}expenses",
                                amount.toString()
                            )
                            .apply()
                    }
                }

                // Current Balance automatically recalculates.
                editingAmount = null
            }
        )
    }
}

// Income and Expenses cards.
@Composable
private fun StatCard(
    label: String,
    value: String,
    valueColor: Color,
    onEdit: () -> Unit,
    modifier: Modifier = Modifier
) {
    val colors = MaterialTheme.colorScheme

    Card(
        modifier = modifier,
        shape = RoundedCornerShape(16.dp),
        colors = CardDefaults.cardColors(
            containerColor = colors.surface
        )
    ) {
        Column(
            modifier = Modifier.padding(16.dp)
        ) {
            Row(
                verticalAlignment = Alignment.CenterVertically
            ) {
                Text(
                    text = label,
                    style = MaterialTheme.typography.bodySmall,
                    color = colors.onSurfaceVariant,
                    modifier = Modifier.weight(1f)
                )

                IconButton(
                    onClick = onEdit,
                    modifier = Modifier.size(28.dp)
                ) {
                    Icon(
                        imageVector = Icons.Outlined.Edit,
                        contentDescription = "Edit $label",
                        tint = colors.primary,
                        modifier = Modifier.size(17.dp)
                    )
                }
            }

            Spacer(Modifier.height(4.dp))

            Text(
                text = value,
                style = MaterialTheme.typography.titleLarge,
                fontWeight = FontWeight.SemiBold,
                color = valueColor
            )
        }
    }
}

// Individual transaction row.
@Composable
private fun TransactionRow(
    transaction: SampleTransaction
) {
    val colors = MaterialTheme.colorScheme

    val isIncome = transaction.amount >= 0
    val sign = if (isIncome) "+" else "-"

    Row(
        modifier = Modifier
            .fillMaxWidth()
            .padding(vertical = 10.dp),
        verticalAlignment = Alignment.CenterVertically
    ) {
        Box(
            modifier = Modifier
                .size(40.dp)
                .background(
                    colors.secondaryContainer,
                    CircleShape
                ),
            contentAlignment = Alignment.Center
        ) {
            Icon(
                imageVector = transaction.icon,
                contentDescription = null,
                tint = colors.primary
            )
        }

        Spacer(Modifier.width(12.dp))

        Column(
            modifier = Modifier.weight(1f)
        ) {
            Text(
                text = transaction.name,
                style = MaterialTheme.typography.bodyLarge,
                fontWeight = FontWeight.Medium,
                color = colors.onSurface
            )

            Text(
                text = "${transaction.category} · ${transaction.date}",
                style = MaterialTheme.typography.bodySmall,
                color = colors.onSurfaceVariant
            )
        }

        Text(
            text = "$sign${money(abs(transaction.amount))}",
            style = MaterialTheme.typography.bodyLarge,
            fontWeight = FontWeight.SemiBold,
            color = if (isIncome) {
                colors.primary
            } else {
                colors.onSurface
            }
        )
    }
}

// Light green editing dialog.
@Composable
private fun EditAmountDialog(
    label: String,
    currentValue: Double?,
    onDismiss: () -> Unit,
    onSave: (Double) -> Unit
) {
    var amountText by remember(label, currentValue) {
        mutableStateOf(
            currentValue?.let {
                String.format(Locale.US, "%.2f", it)
            } ?: ""
        )
    }

    val amount = amountText.trim()
        .replace("$", "")
        .replace(",", "")
        .toDoubleOrNull()

    val isValid = amount != null &&
            amount.isFinite() &&
            amount > 0.0

    val colors = MaterialTheme.colorScheme

    AlertDialog(
        onDismissRequest = onDismiss,

        // Matching green pop-up styling.
        containerColor = colors.primaryContainer,
        titleContentColor = colors.onPrimaryContainer,
        textContentColor = colors.onPrimaryContainer,
        shape = RoundedCornerShape(24.dp),

        title = {
            Text(
                text = "Edit $label",
                fontWeight = FontWeight.SemiBold
            )
        },

        text = {
            OutlinedTextField(
                value = amountText,
                onValueChange = {
                    amountText = it
                },
                label = {
                    Text("Amount (CAD)")
                },
                singleLine = true,
                shape = RoundedCornerShape(12.dp),

                isError = amountText.isNotBlank() && !isValid,

                keyboardOptions = KeyboardOptions(
                    keyboardType = KeyboardType.Decimal
                ),

                colors = OutlinedTextFieldDefaults.colors(
                    focusedContainerColor = colors.surface,
                    unfocusedContainerColor = colors.surface,
                    errorContainerColor = colors.surface,
                    focusedBorderColor = colors.primary,
                    cursorColor = colors.primary
                ),

                supportingText = {
                    Text(
                        text = if (
                            amountText.isNotBlank() && !isValid
                        ) {
                            "Amount must be greater than 0"
                        } else {
                            "Enter an amount"
                        },
                        color = if (
                            amountText.isNotBlank() && !isValid
                        ) {
                            colors.error
                        } else {
                            colors.onSurfaceVariant
                        }
                    )
                }
            )
        },

        confirmButton = {
            TextButton(
                enabled = isValid,
                onClick = {
                    amount?.let(onSave)
                }
            ) {
                Text("Save")
            }
        },

        dismissButton = {
            TextButton(
                onClick = onDismiss
            ) {
                Text("Cancel")
            }
        }
    )
}
