
package com.group3.spendwise.ui.screens

import android.content.Intent
import android.net.Uri
import androidx.compose.foundation.background
import androidx.compose.foundation.layout.*
import androidx.compose.foundation.shape.CircleShape
import androidx.compose.material.icons.Icons
import androidx.compose.material.icons.filled.Add
import androidx.compose.material.icons.outlined.AccountBalanceWallet
import androidx.compose.material.icons.outlined.Dashboard
import androidx.compose.material.icons.outlined.Insights
import androidx.compose.material.icons.outlined.SwapHoriz
import androidx.compose.material3.*
import androidx.compose.runtime.*
import androidx.compose.runtime.saveable.rememberSaveable
import androidx.compose.ui.Alignment
import androidx.compose.ui.Modifier
import androidx.compose.ui.graphics.vector.ImageVector
import androidx.compose.ui.platform.LocalContext
import androidx.compose.ui.text.font.FontWeight
import androidx.compose.ui.unit.dp
import com.google.firebase.auth.FirebaseAuth
import com.group3.spendwise.data.local.SpendWiseDatabase
import com.group3.spendwise.data.local.TransactionEntity
import kotlinx.coroutines.flow.flowOf
import kotlinx.coroutines.launch

private data class BottomTab(
    val label: String,
    val icon: ImageVector
)

// Convert database record to UI model.
private fun TransactionEntity.toSpendTransaction(): SpendTransaction {
    return SpendTransaction(
        id = id,
        description = description,
        amount = amount,
        category = category,
        date = date,
        kind = if (kind == TransactionKind.INCOME.name) {
            TransactionKind.INCOME
        } else {
            TransactionKind.EXPENSE
        },
        notes = notes,
        receiptUri = receiptUri
    )
}

// Convert UI model to database record.
private fun SpendTransaction.toEntity(
    ownerUid: String
): TransactionEntity {
    return TransactionEntity(
        id = id,
        ownerUid = ownerUid,
        description = description,
        amount = amount,
        category = category,
        date = date,
        kind = kind.name,
        notes = notes,
        receiptUri = receiptUri
    )
}

@Composable
fun MainScreen(
    userName: String,
    userEmail: String,
    onLogout: () -> Unit,
    isDarkMode: Boolean,
    onDarkModeChange: (Boolean) -> Unit
) {
    val context = LocalContext.current

    val database = remember(context) {
        SpendWiseDatabase.getInstance(context)
    }

    val transactionDao = remember(database) {
        database.transactionDao()
    }

    val ownerUid = FirebaseAuth.getInstance()
        .currentUser?.uid.orEmpty()

    val transactionFlow = remember(transactionDao, ownerUid) {
        if (ownerUid.isNotBlank()) {
            transactionDao.observeForUser(ownerUid)
        } else {
            flowOf(emptyList<TransactionEntity>())
        }
    }

    val savedEntities by transactionFlow.collectAsState(
        initial = emptyList()
    )

    val transactions = savedEntities.map {
        it.toSpendTransaction()
    }

    val scope = rememberCoroutineScope()

    val snackbarHostState = remember {
        SnackbarHostState()
    }

    var selectedTab by rememberSaveable(ownerUid) {
        mutableIntStateOf(0)
    }

    // Track transaction details/edit screens.
    var transactionRoute by rememberSaveable(ownerUid) {
        mutableStateOf("tabs")
    }

    var selectedTransactionId by rememberSaveable(ownerUid) {
        mutableStateOf<Long?>(null)
    }

    val selectedTransaction = transactions.firstOrNull {
        it.id == selectedTransactionId
    }

    val colors = MaterialTheme.colorScheme

    // Delete a transaction permanently from Room.
    val deleteTransaction: (SpendTransaction) -> Unit = { transaction ->

        if (ownerUid.isNotBlank()) {
            scope.launch {
                try {
                    val deleted = transactionDao.delete(
                        transactionId = transaction.id,
                        ownerUid = ownerUid
                    )

                    if (deleted > 0) {
                        transactionRoute = "tabs"
                        selectedTab = 1
                        selectedTransactionId = null

                        snackbarHostState.showSnackbar(
                            "Transaction deleted"
                        )
                    } else {
                        snackbarHostState.showSnackbar(
                            "Transaction not found"
                        )
                    }

                } catch (e: Exception) {
                    snackbarHostState.showSnackbar(
                        "Unable to delete transaction"
                    )
                }
            }
        }
    }

    // Open a receipt in an installed image viewer.
    val viewReceipt: (SpendTransaction) -> Unit = { transaction ->

        val uriString = transaction.receiptUri

        if (uriString != null) {
            try {
                val uri = Uri.parse(uriString)

                val intent = Intent(Intent.ACTION_VIEW).apply {
                    setDataAndType(uri, "image/*")
                    addFlags(
                        Intent.FLAG_GRANT_READ_URI_PERMISSION
                    )
                }

                context.startActivity(intent)

            } catch (e: Exception) {
                scope.launch {
                    snackbarHostState.showSnackbar(
                        "Unable to open receipt"
                    )
                }
            }
        }
    }

    val tabs = listOf(
        BottomTab("Dashboard", Icons.Outlined.Dashboard),
        BottomTab("Transactions", Icons.Outlined.SwapHoriz),
        BottomTab("Add", Icons.Filled.Add),
        BottomTab("Budget", Icons.Outlined.AccountBalanceWallet),
        BottomTab("Insights", Icons.Outlined.Insights)
    )

    Scaffold(
        containerColor = colors.background,

        snackbarHost = {
            SnackbarHost(hostState = snackbarHostState)
        },

        bottomBar = {
            NavigationBar(
                containerColor = colors.surface
            ) {
                tabs.forEachIndexed { index, tab ->

                    NavigationBarItem(
                        selected = selectedTab == index &&
                                transactionRoute == "tabs",

                        onClick = {
                            transactionRoute = "tabs"
                            selectedTransactionId = null
                            selectedTab = index
                        },

                        icon = {
                            if (tab.label == "Add") {
                                Box(
                                    modifier = Modifier
                                        .size(40.dp)
                                        .background(
                                            colors.primary,
                                            CircleShape
                                        ),
                                    contentAlignment = Alignment.Center
                                ) {
                                    Icon(
                                        imageVector = tab.icon,
                                        contentDescription = tab.label,
                                        tint = colors.onPrimary
                                    )
                                }
                            } else {
                                Icon(
                                    imageVector = tab.icon,
                                    contentDescription = tab.label
                                )
                            }
                        },

                        label = {
                            Text(
                                text = tab.label,
                                style = MaterialTheme.typography.labelSmall,
                                maxLines = 1
                            )
                        },

                        colors = NavigationBarItemDefaults.colors(
                            selectedIconColor = colors.primary,
                            selectedTextColor = colors.primary,
                            indicatorColor = colors.secondaryContainer,
                            unselectedIconColor =
                                colors.onSurfaceVariant,
                            unselectedTextColor =
                                colors.onSurfaceVariant
                        )
                    )
                }
            }
        }
    ) { innerPadding ->

        Box(
            modifier = Modifier
                .fillMaxSize()
                .padding(innerPadding)
        ) {

            when {

                // Transaction Details
                transactionRoute == "details" &&
                        selectedTransaction != null -> {

                    TransactionDetailsScreen(
                        transaction = selectedTransaction,

                        onBack = {
                            transactionRoute = "tabs"
                            selectedTab = 1
                        },

                        onEdit = {
                            transactionRoute = "edit"
                        },

                        onDelete = {
                            deleteTransaction(selectedTransaction)
                        },

                        onViewReceipt = {
                            viewReceipt(selectedTransaction)
                        }
                    )
                }

                // Edit Transaction
                transactionRoute == "edit" &&
                        selectedTransaction != null -> {

                    AddTransactionScreen(
                        transactionToEdit = selectedTransaction,

                        onBack = {
                            transactionRoute = "details"
                        },

                        onDelete = {
                            deleteTransaction(selectedTransaction)
                        },

                        onSave = { updatedTransaction ->

                            if (ownerUid.isNotBlank()) {

                                scope.launch {
                                    try {
                                        val updated = transactionDao.update(
                                            transactionId =
                                                updatedTransaction.id,
                                            ownerUid = ownerUid,
                                            description =
                                                updatedTransaction.description,
                                            amount =
                                                updatedTransaction.amount,
                                            category =
                                                updatedTransaction.category,
                                            date =
                                                updatedTransaction.date,
                                            kind =
                                                updatedTransaction.kind.name,
                                            notes =
                                                updatedTransaction.notes,
                                            receiptUri =
                                                updatedTransaction.receiptUri
                                        )

                                        if (updated > 0) {
                                            transactionRoute = "details"

                                            snackbarHostState.showSnackbar(
                                                "Transaction updated successfully"
                                            )
                                        } else {
                                            snackbarHostState.showSnackbar(
                                                "Transaction not found"
                                            )
                                        }

                                    } catch (e: Exception) {
                                        snackbarHostState.showSnackbar(
                                            "Unable to update transaction"
                                        )
                                    }
                                }
                            }
                        }
                    )
                }

                // Transaction still loading
                transactionRoute != "tabs" -> {

                    Column(
                        modifier = Modifier.fillMaxSize(),
                        horizontalAlignment = Alignment.CenterHorizontally,
                        verticalArrangement = Arrangement.Center
                    ) {
                        Text(
                            text = "Loading transaction...",
                            color = colors.onBackground
                        )

                        Spacer(Modifier.height(12.dp))

                        TextButton(
                            onClick = {
                                transactionRoute = "tabs"
                                selectedTab = 1
                            }
                        ) {
                            Text("Back to Transactions")
                        }
                    }
                }

                else -> {
                    when (selectedTab) {

                        // Dashboard
                        0 -> DashboardScreen(
                            userName = userName,
                            userEmail = userEmail,
                            onLogout = onLogout,
                            isDarkMode = isDarkMode,
                            onDarkModeChange = onDarkModeChange
                        )

                        // Transaction History
                        1 -> TransactionsScreen(
                            transactions = transactions,

                            onAddClick = {
                                selectedTab = 2
                            },

                            onTransactionClick = { transaction ->
                                selectedTransactionId = transaction.id
                                transactionRoute = "details"
                            },

                            onEditClick = { transaction ->
                                selectedTransactionId = transaction.id
                                transactionRoute = "edit"
                            },

                            onDeleteClick = { transaction ->
                                deleteTransaction(transaction)
                            },

                            onReceiptClick = { transaction ->
                                viewReceipt(transaction)
                            }
                        )

                        // Add Transaction
                        2 -> AddTransactionScreen(
                            onBack = {
                                selectedTab = 1
                            },

                            onSave = { newTransaction ->

                                if (ownerUid.isBlank()) {
                                    scope.launch {
                                        snackbarHostState.showSnackbar(
                                            "Please sign in to save transactions"
                                        )
                                    }
                                } else {
                                    scope.launch {
                                        try {
                                            transactionDao.insert(
                                                newTransaction.toEntity(
                                                    ownerUid
                                                ).copy(id = 0L)
                                            )

                                            selectedTab = 1

                                            snackbarHostState.showSnackbar(
                                                "Transaction saved successfully"
                                            )

                                        } catch (e: Exception) {
                                            snackbarHostState.showSnackbar(
                                                "Unable to save transaction"
                                            )
                                        }
                                    }
                                }
                            }
                        )

                        // Budget
                        3 -> PlaceholderScreen(
                            title = "Budget"
                        )

                        // Insights
                        4 -> PlaceholderScreen(
                            title = "Insights"
                        )
                    }
                }
            }
        }
    }
}

// Placeholder screens
@Composable
private fun PlaceholderScreen(
    title: String
) {
    val colors = MaterialTheme.colorScheme

    Column(
        modifier = Modifier.fillMaxSize(),
        verticalArrangement = Arrangement.Center,
        horizontalAlignment = Alignment.CenterHorizontally
    ) {
        Text(
            text = title,
            style = MaterialTheme.typography.headlineSmall,
            fontWeight = FontWeight.Bold,
            color = colors.onBackground
        )

        Spacer(Modifier.height(8.dp))

        Text(
            text = "Coming in the next phase of development.",
            style = MaterialTheme.typography.bodyMedium,
            color = colors.onSurfaceVariant
        )
    }
}
